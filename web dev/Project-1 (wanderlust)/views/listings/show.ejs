<% layout("/layouts/boilerplate") %>
<h3>Listing Details :</h3>
<ul>
  <li><%= listing.title %></li>
  <li><%= listing.description %></li>
  <li>&#8377; <%= listing.price.toLocaleString("en-IN") %></li>
  <li><%= listing.location %></li>
  <li><%= listing.country %></li>
</ul>
<br />
<a href="/listings/<%= listing._id %>/edit">Edit this Listing</a>
<br /><br />
<form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
  <button>Delete this listing</button>
</form>

<!-- &#8377; is code for rupees symbol -->
<!-- number.toLocaleString("en-IN") converts it into string and add commas based on number system of respective country -->
