<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Chat</title>
  </head>
  <body>
    <h3>Write New Chat</h3>
    <form method="POST" action="/chats">
      <input placeholder="Who are you?" type="text" name="from" id="from" />
      <input placeholder="Receiver's name?" type="text" name="to" id="to" />
      <textarea placeholder="Write your Message" name="msg" id="msg"></textarea>
      <button type="submit">Create Chat</button>
    </form>
  </body>
</html>
