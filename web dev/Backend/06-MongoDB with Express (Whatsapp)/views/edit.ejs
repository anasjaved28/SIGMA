<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit your Message</title>
  </head>
  <body>
    <h3>Edit Message</h3>
    <div class="chat">
      <p>From : <%=chat.from%></p>
      <div class="msg">
        <form method="POST" action="/chats/<%=chat._id%>?_method=PUT">
          <textarea name="msg" id="msg"><%=chat.msg%></textarea>
          <button type="submit">Edit</button>
        </form>
      </div>
      <p>To : <%=chat.to%></p>
      <hr />
    </div>
  </body>
</html>
